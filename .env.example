# Copy this file to .env and fill in your keys. Never commit the real .env.

# Required for English narration (GroqTTSProvider).
# Get a free key at https://console.groq.com/keys
# You must also accept the model terms once at:
# https://console.groq.com/playground?model=canopylabs/orpheus-v1-english
GROQ_API_KEY=

# Optional: only needed once GoogleCloudTTSProvider is implemented for
# non-English narration. Path to a service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: override the ffmpeg binary path if it's not on your PATH.
# FFMPEG_BINARY=/usr/local/bin/ffmpeg
